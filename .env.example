# --- FalkorDB -------------------------------------------------------------
# Local Docker (default of run.sh / docker-compose.yml)
FALKORDB_HOST=localhost
FALKORDB_PORT=6381
# FALKORDB_PASSWORD=            # set if your FalkorDB (e.g. Cloud) requires auth

# --- LLM ------------------------------------------------------------------
# auto = try Ollama, then OpenAI-compatible (if key set), then built-in Mock
LLM_MODE=auto                   # auto | ollama | openai | mock
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b         # any tool-calling model, e.g. llama3.1:8b, mistral-nemo
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_AGENT_STEPS=20
MAX_AUDITOR_STEPS=8
